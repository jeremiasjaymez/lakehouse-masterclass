# Copiá este archivo a .env y ajustá los valores para tu entorno local.
# .env NO se versiona: es tu configuración local, no la del curso.

# Vault (Lab 6) — el token 'root' solo existe en el modo dev de Vault
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=root

# Silencia el warning de MkDocs 2.x al servir la documentación
NO_MKDOCS_2_WARNING=1
